<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion Commandes - Brasil Burger Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f6fa;
            color: #2c1810;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            padding: 2rem 0;
            position: fixed;
            height: 100vh;
            width: 280px;
            overflow-y: auto;
            left: 0;
            top: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

        .logo-section {
            padding: 0 1.5rem 2rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 2rem;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
        }

        .admin-logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FFD700, #FFA500);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .admin-logo-text h2 {
            color: white;
            font-size: 1.3rem;
            font-weight: 800;
        }

        .admin-logo-text p {
            color: rgba(255,255,255,0.6);
            font-size: 0.75rem;
        }

        .nav-menu {
            list-style: none;
            padding: 0 1rem;
        }

        .nav-item {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .nav-link.active {
            background: linear-gradient(135deg, #C8102E, #FF4655);
            color: white;
        }

        .nav-link i {
            width: 20px;
            font-size: 1.1rem;
        }

        .main-content {
            margin-left: 280px;
            padding: 2rem;
            width: calc(100% - 280px);
            min-height: 100vh;
        }

        .top-bar {
            background: white;
            padding: 1.5rem 2rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #C8102E;
        }

        .btn-menu-mobile {
            display: none;
            background: #C8102E;
            color: white;
            border: none;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .filters-bar {
            background: white;
            padding: 1.5rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .filter-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #8B4513;
        }

        .filter-select {
            padding: 0.8rem;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-family: 'Poppins', sans-serif;
            transition: all 0.3s ease;
        }

        .filter-select:focus {
            outline: none;
            border-color: #C8102E;
        }

        .btn-filter {
            background: linear-gradient(135deg, #C8102E, #FF4655);
            color: white;
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            align-self: flex-end;
        }

        .btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(200, 16, 46, 0.3);
        }

        .status-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: white;
            color: #2c1810;
            border: 2px solid #e0e0e0;
            padding: 1rem 2rem;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .tab-btn:hover, .tab-btn.active {
            background: #C8102E;
            color: white;
            border-color: #C8102E;
        }

        .tab-badge {
            background: rgba(0,0,0,0.1);
            padding: 0.2rem 0.6rem;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .tab-btn.active .tab-badge {
            background: rgba(255,255,255,0.2);
        }

        .orders-grid {
            display: grid;
            gap: 1.5rem;
        }

        .order-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

        .order-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .order-card-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f8f9fa;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .order-number {
            font-size: 1.3rem;
            font-weight: 800;
            color: #C8102E;
            margin-bottom: 0.3rem;
        }

        .order-time {
            color: #8B4513;
            font-size: 0.85rem;
        }

        .order-status-badge {
            padding: 0.6rem 1.2rem;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        .status-pending {
            background: #FFF3E0;
            color: #F57C00;
        }

        .status-preparing {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.2));
            color: #FFA500;
        }

        .status-ready {
            background: #E8F5E9;
            color: #4CAF50;
        }

        .status-delivering {
            background: #E3F2FD;
            color: #2196F3;
        }

        .status-cancelled {
            background: #FFEBEE;
            color: #f44336;
        }

        .order-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .info-item {
            display: flex;
            gap: 0.5rem;
            color: #2c1810;
            font-size: 0.9rem;
        }

        .info-item i {
            color: #C8102E;
            width: 20px;
        }

        .order-items {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
        }

        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
        }

        .order-item-name {
            font-weight: 600;
            color: #2c1810;
        }

        .order-item-price {
            color: #C8102E;
            font-weight: 700;
        }

        .order-total {
            font-size: 1.3rem;
            font-weight: 800;
            color: #C8102E;
            text-align: right;
            padding-top: 0.5rem;
            border-top: 2px solid #e0e0e0;
        }

        .order-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-action {
            flex: 1;
            min-width: 150px;
            padding: 0.9rem;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-complete {
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
        }

        .btn-complete:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
        }

        .btn-cancel {
            background: white;
            color: #f44336;
            border: 2px solid #f44336;
        }

        .btn-cancel:hover {
            background: #f44336;
            color: white;
        }

        .btn-view {
            background: linear-gradient(135deg, #2196F3, #1976D2);
            color: white;
        }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(33, 150, 243, 0.3);
        }

        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-280px);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .btn-menu-mobile {
                display: block;
            }
        }

        @media (max-width: 768px) {
            .filters-grid {
                grid-template-columns: 1fr;
            }

            .status-tabs {
                overflow-x: auto;
                flex-wrap: nowrap;
            }

            .order-actions {
                flex-direction: column;
            }

            .btn-action {
                width: 100%;
                min-width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo-section">
                <a href="{{ path('admin_dashboard') }}" class="admin-logo">
                    <div class="admin-logo-icon">🍔</div>
                    <div class="admin-logo-text">
                        <h2>Brasil Burger</h2>
                        <p>Panneau Admin</p>
                    </div>
                </a>
            </div>

            <nav>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link">
                            <i class="fas fa-chart-line"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_commandes_index') }}" class="nav-link active">
                            <i class="fas fa-shopping-bag"></i>
                            <span>Commandes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_burgers_index') }}" class="nav-link">
                            <i class="fas fa-hamburger"></i>
                            <span>Produits</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a href="brasil_burger_admin_complements.html" class="nav-link">
                            <i class="fas fa-plus-circle"></i>
                            <span>Compléments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_delivery.html" class="nav-link">
                            <i class="fas fa-motorcycle"></i>
                            <span>Livraisons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_customers.html" class="nav-link">
                            <i class="fas fa-users"></i>
                            <span>Clients</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a href="brasil_burger_admin_login.html" class="nav-link">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Déconnexion</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="top-bar">
                <button class="btn-menu-mobile" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">Gestion des Commandes</h1>
            </div>

            <!-- Filters -->
            <div class="filters-bar">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label class="filter-label">Date</label>
                        <input type="date" class="filter-select">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Client</label>
                        <input type="text" class="filter-select" placeholder="Rechercher un client">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Type</label>
                        <select class="filter-select">
                            <option>Tous</option>
                            <option>Menu</option>
                            <option>Burger</option>
                            <option>Complément</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">&nbsp;</label>
                        <button class="btn-filter">
                            <i class="fas fa-filter"></i>
                            Filtrer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Status Tabs -->
            <div class="status-tabs">
    {% for key, count in stats %}
        <a href="{{ path('admin_commandes_index', {status: key != 'ALL' ? key : null}) }}"
           class="tab-btn {{ filters.status == key ? 'active' : '' }}">
            {{ key|replace({'_':' '}) }}
            <span class="tab-badge">{{ count }}</span>
        </a>
    {% endfor %}
</div>


            <!-- Orders Grid -->
            <div class="orders-grid">
{% for commande in commandes %}
    <div class="order-card">

        <div class="order-card-header">
            <div>
                <div class="order-number">#BB-{{ commande.id }}</div>
                <div class="order-time">
                    {{ commande.dateCommande|date('d/m/Y H:i') }}
                </div>
            </div>

            <span class="order-status-badge status-{{ commande.etatCommande|lower }}">
                {{ commande.etatCommande }}
            </span>
        </div>

        <div class="order-info-grid">
            <div class="info-item">
                <i class="fas fa-user"></i>
                <strong>{{ commande.client.prenom }} {{ commande.client.nom }}</strong>
            </div>

            <div class="info-item">
                <i class="fas fa-phone"></i>
                {{ commande.client.telephone }}
            </div>

            <div class="info-item">
                <i class="fas fa-motorcycle"></i>
                {{ commande.typeCommande }}
            </div>
        </div>

        <div class="order-total">
            Total : {{ commande.total|number_format(0, ',', ' ') }} FCFA
        </div>

        <div class="order-actions">
            <a href="{{ path('admin_commandes_show', {id: commande.id}) }}" class="btn-action btn-view">
                <i class="fas fa-eye"></i> Détails
            </a>
        </div>
    </div>
{% else %}
    <p>Aucune commande trouvée.</p>
{% endfor %}
</div>

        </main>
    </div>

    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('active');
        }

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });

        document.addEventListener('click', function(event) {
            const sidebar = document.querySelector('.sidebar');
            const menuBtn = document.querySelector('.btn-menu-mobile');
            
            if (window.innerWidth <= 1024) {
                if (!sidebar.contains(event.target) && event.target !== menuBtn && !menuBtn.contains(event.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });
    </script>
</body>
</html>