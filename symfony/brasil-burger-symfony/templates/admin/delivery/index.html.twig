                                </div>
                                <div class="stat-box">
                                    <div class="stat-box-value">4.7</div>
                                    <div class="stat-box-label">Note</div>
                                </div>
                                <div class="stat-box">
                                    <div class="stat-box-value">95%</div>
                                    <div class="stat-box-label">Succès</div>
                                </div>
                            </div>
                        </div>

                        <!-- Person 4 - Offline -->
                        <div class="person-card" style="opacity: 0.6;">
                            <div class="person-header">
