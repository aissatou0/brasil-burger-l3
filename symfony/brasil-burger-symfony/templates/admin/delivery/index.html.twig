            <!-- Zones Section (Hidden by default) -->
            <div class="zones-grid" id="zonesContent" style="display: none;">
                <!-- Zone 1 -->
                <div class="zone-card">
                    <div class="zone-header">
                        <div class="zone-name">Zone Nord</div>
                        <div class="zone-price">1500 F</div>
                    </div>
                    <div class="zone-quartiers">
                        <div class="quartiers-title">Quartiers couverts</div>
                        <div class="quartiers-list">
                            <span class="quartier-tag">Almadies</span>
