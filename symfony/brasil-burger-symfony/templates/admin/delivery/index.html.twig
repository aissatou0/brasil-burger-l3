    <!-- Modal: Assign Delivery Person -->
    <div id="assignModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Affecter un livreur</h2>
                <button class="btn-close" onclick="closeModal('assignModal')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="form-group">
                <label class="form-label">Commande <strong id="orderNumber"></strong></label>
            </div>

            <div class="delivery-persons-modal">
                <div class="person-option" onclick="this.classList.toggle('selected')">
                    <div class="person-avatar">AB</div>
                    <div class="person-info">
                        <div class="person-name">Abdou Sarr</div>
                        <div class="person-status">
                            <span class="status-dot dot-available"></span>
                            Disponible - 12 livraisons aujourd'hui
                        </div>
                    </div>
                </div>

                <div class="person-option" onclick="this.classList.toggle('selected')">
                    <div class="person-avatar">MO</div>
                    <div class="person-info">
                        <div class="person-name">Moussa Fall</div>
                        <div class="person-status">
                            <span class="status-dot dot-available"></span>
                            Disponible - 8 livraisons aujourd'hui
                        </div>
                    </div>
                </div>

                <div class="person-option" style="opacity: 0.5;">
                    <div class="person-avatar">IB</div>
                    <div class="person-info">
                        <div class="person-name">Ibrahima Diop</div>
                        <div class="person-status">
                            <span class="status-dot dot-busy"></span>
                            Occupé - 2 livraisons en cours
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="btn-submit" onclick="closeModal('assignModal')">
                <i class="fas fa-check"></i>
                Confirmer l'affectation
            </button>
        </div>
    </div>

    <!-- Modal: Add Zone -->
    <div id="zoneModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Ajouter une Zone</h2>
                <button class="btn-close" onclick="closeModal('zoneModal')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form>
                <div class="form-group">
                    <label class="form-label">Nom de la zone</label>
                    <input type="text" class="form-input" placeholder="Ex: Zone Nord" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Prix de livraison (FCFA)</label>
                    <input type="number" class="form-input" placeholder="Ex: 1500" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Quartiers (séparés par des virgules)</label>
                    <input type="text" class="form-input" placeholder="Ex: Almadies, Ngor, Ouakam" required>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i>
                    Enregistrer la zone
                </button>
            </form>
        </div>
    </div>

    <!-- Modal: Add Delivery Person -->
    <div id="addDeliveryPersonModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Ajouter un Livreur</h2>
                <button class="btn-close" onclick="closeModal('addDeliveryPersonModal')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form>
                <div class="form-group">
                    <label class="form-label">Nom complet</label>
                    <input type="text" class="form-input" placeholder="Ex: Abdou Sarr" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Téléphone</label>
                    <input type="tel" class="form-input" placeholder="+221 77 123 45 67" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-input" placeholder="abdou@example.com">
                </div>

                <div class="form-group">
                    <label class="form-label">Zone principale</label>
                    <select class="form-select" required>
                        <option value="">-- Choisir une zone --</option>
                        <option value="nord">Zone Nord</option>
                        <option value="centre">Zone Centre</option>
                        <option value="sud">Zone Sud</option>
                    </select>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-user-plus"></i>
                    Ajouter le livreur
                </button>
            </form>
        </div>
    </div>

    <script>
        function showZones() {
            document.getElementById('deliveryContent').style.display = 'none';
            document.getElementById('zonesContent').style.display = 'grid';
        }

        function showDeliveries() {
            document.getElementById('deliveryContent').style.display = 'grid';
            document.getElementById('zonesContent').style.display = 'none';
        }

        function openAssignModal(orderNumber) {
            document.getElementById('orderNumber').textContent = orderNumber;
            document.getElementById('assignModal').classList.add('active');
        }

        function openZoneModal() {
            document.getElementById('zoneModal').classList.add('active');
        }

        function openAddDeliveryPersonModal() {
            document.getElementById('addDeliveryPersonModal').classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }
    </script>
</body>
</html>