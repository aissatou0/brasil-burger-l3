<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Brasil Burger Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f6fa;
            color: #2c1810;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            padding: 2rem 0;
            position: fixed;
            height: 100vh;
            width: 280px;
            overflow-y: auto;
            left: 0;
            top: 0;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

        .logo-section {
            padding: 0 1.5rem 2rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 2rem;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
        }

        .admin-logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FFD700, #FFA500);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .admin-logo-text h2 {
            color: white;
            font-size: 1.3rem;
            font-weight: 800;
        }

        .admin-logo-text p {
            color: rgba(255,255,255,0.6);
            font-size: 0.75rem;
        }

        .nav-menu {
            list-style: none;
            padding: 0 1rem;
        }

        .nav-item {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .nav-link.active {
            background: linear-gradient(135deg, #C8102E, #FF4655);
            color: white;
            box-shadow: 0 4px 15px rgba(200, 16, 46, 0.3);
        }

        .nav-link i {
            width: 20px;
            font-size: 1.1rem;
        }

        /* Main Content */
        .main-content {
            margin-left: 280px;
            padding: 2rem;
            width: calc(100% - 280px);
            min-height: 100vh;
        }

        .top-bar {
            background: white;
            padding: 1.5rem 2rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #C8102E;
        }

        .btn-menu-mobile {
            display: none;
            background: #C8102E;
            color: white;
            border: none;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .top-bar-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
        }

        .search-input {
            padding: 0.8rem 1.2rem 0.8rem 3rem;
            border: 2px solid #e0e0e0;
            border-radius: 25px;
            width: 300px;
            font-family: 'Poppins', sans-serif;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #C8102E;
        }

        .search-icon {
            position: absolute;
            left: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            color: #8B4513;
        }

        .btn-notification {
            position: relative;
            width: 45px;
            height: 45px;
            background: #f8f9fa;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-notification:hover {
            background: #C8102E;
            color: white;
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #FF4655;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            font-size: 0.7rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.5rem 1rem;
            background: #f8f9fa;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .user-profile:hover {
            background: #e9ecef;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #C8102E, #FF4655);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
        }

        .user-info h4 {
            font-size: 0.95rem;
            color: #2c1810;
        }

        .user-info p {
            font-size: 0.75rem;
            color: #8B4513;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.8rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            gap: 1.5rem;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .stat-icon {
            width: 65px;
            height: 65px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            flex-shrink: 0;
        }

        .stat-icon.red {
            background: linear-gradient(135deg, rgba(200, 16, 46, 0.1), rgba(255, 70, 85, 0.1));
            color: #C8102E;
        }

        .stat-icon.yellow {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.2));
            color: #FFA500;
        }

        .stat-icon.green {
            background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(69, 160, 73, 0.1));
            color: #4CAF50;
        }

        .stat-icon.blue {
            background: linear-gradient(135deg, rgba(33, 150, 243, 0.1), rgba(25, 118, 210, 0.1));
            color: #2196F3;
        }

        .stat-info {
            flex: 1;
        }

        .stat-label {
            color: #8B4513;
            font-size: 0.9rem;
            margin-bottom: 0.3rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #2c1810;
        }

        .stat-change {
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            margin-top: 0.3rem;
        }

        .stat-change.positive {
            color: #4CAF50;
        }

        .stat-change.negative {
            color: #f44336;
        }

        /* Charts Section */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .card {
            background: white;
            padding: 2rem;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .card-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2c1810;
        }

        .card-filter {
            display: flex;
            gap: 0.5rem;
        }

        .filter-btn {
            padding: 0.5rem 1rem;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 10px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .filter-btn.active, .filter-btn:hover {
            background: #C8102E;
            color: white;
            border-color: #C8102E;
        }

        .chart-placeholder {
            width: 100%;
            height: 300px;
            background: linear-gradient(135deg, #FFF8E7, #FFEFD5);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8B4513;
            font-size: 1.1rem;
        }

        /* Top Products */
        .product-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .product-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .product-item:hover {
            background: #FFF8E7;
        }

        .product-rank {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #C8102E, #FF4655);
            color: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            flex-shrink: 0;
        }

        .product-image {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .product-details {
            flex: 1;
        }

        .product-name {
            font-weight: 600;
            color: #2c1810;
            margin-bottom: 0.2rem;
        }

        .product-sales {
            font-size: 0.85rem;
            color: #8B4513;
        }

        .product-badge {
            background: linear-gradient(135deg, #FFD700, #FFA500);
            color: #C8102E;
            padding: 0.3rem 0.8rem;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        /* Recent Orders */
        .orders-table {
            width: 100%;
            margin-top: 1rem;
        }

        .orders-table th {
            text-align: left;
            padding: 1rem;
            color: #8B4513;
            font-weight: 600;
            font-size: 0.85rem;
            border-bottom: 2px solid #FFEFD5;
        }

        .orders-table td {
            padding: 1rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .order-id {
            font-weight: 700;
            color: #C8102E;
        }

        .status-badge {
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-align: center;
        }

        .status-pending {
            background: #FFF3E0;
            color: #F57C00;
        }

        .status-preparing {
            background: #FFF8E7;
            color: #FFA500;
        }

        .status-ready {
            background: #E8F5E9;
            color: #4CAF50;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-280px);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .btn-menu-mobile {
                display: block;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .search-input {
                width: 100%;
            }

            .top-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .top-bar-actions {
                width: 100%;
                justify-content: space-between;
            }

            .user-info {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo-section">
                <a href="brasil_burger_admin_dashboard.html" class="admin-logo">
                    <div class="admin-logo-icon">🍔</div>
                    <div class="admin-logo-text">
                        <h2>Brasil Burger</h2>
                        <p>Panneau Admin</p>
                    </div>
                </a>
            </div>

            <nav>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="brasil_burger_admin_dashboard.html" class="nav-link active">
                            <i class="fas fa-chart-line"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_orders.html" class="nav-link">
                            <i class="fas fa-shopping-bag"></i>
                            <span>Commandes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_products.html" class="nav-link">
                            <i class="fas fa-hamburger"></i>
                            <span>Produits</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_menus.html" class="nav-link">
                            <i class="fas fa-utensils"></i>
                            <span>Menus</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_complements.html" class="nav-link">
                            <i class="fas fa-plus-circle"></i>
                            <span>Compléments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_delivery.html" class="nav-link">
                            <i class="fas fa-motorcycle"></i>
                            <span>Livraisons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_customers.html" class="nav-link">
                            <i class="fas fa-users"></i>
                            <span>Clients</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_stats.html" class="nav-link">
                            <i class="fas fa-chart-bar"></i>
                            <span>Statistiques</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="fas fa-cog"></i>
                            <span>Paramètres</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="brasil_burger_admin_login.html" class="nav-link">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Déconnexion</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="top-bar">
                <button class="btn-menu-mobile" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">Dashboard</h1>
                <div class="top-bar-actions">
                    <form class="search-box" method="get" action="{{ path('admin_dashboard') }}">
    <input type="hidden" name="period" value="{{ period }}">
    <i class="fas fa-search search-icon"></i>
    <input type="text" name="q" class="search-input" placeholder="Rechercher..." value="{{ q }}">
</form>

                    <button class="btn-notification">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">5</span>
                    </button>
                    <div class="user-profile">
                        <div class="user-avatar">
                        {{ gestionnaire.prenom|first }}{{ gestionnaire.nom|first }}
                    </div>
                    <div class="user-info">
                        <h4>{{ gestionnaire.prenom }} {{ gestionnaire.nom }}</h4>
                        <p>Gestionnaire</p>
                    </div>

                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">

    <!-- Commandes du jour -->
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-shopping-bag"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Commandes du jour</div>
            <div class="stat-value">{{ stats.commandesDuJour }}</div>
        </div>
    </div>

    <!-- En cours -->
    <div class="stat-card">
        <div class="stat-icon yellow">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">En cours</div>
            <div class="stat-value">{{ stats.enCours }}</div>
        </div>
    </div>

    <!-- Recette du jour -->
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-wallet"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Recette du jour</div>
            <div class="stat-value">
                {{ stats.recetteDuJour|number_format(0, ',', ' ') }} F
            </div>
        </div>
    </div>

    <!-- Annulations -->
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-info">
            <div class="stat-label">Annulations</div>
            <div class="stat-value">{{ stats.annulations }}</div>
        </div>
    </div>

</div>


            <!-- Charts & Top Products -->
            <div class="dashboard-grid">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Évolution des ventes</h2>
                        <div class="card-filter">
    <a class="filter-btn {{ period == 'day' ? 'active' : '' }}"
       href="{{ path('admin_dashboard', {period:'day', q:q}) }}">Jour</a>

    <a class="filter-btn {{ period == 'week' ? 'active' : '' }}"
       href="{{ path('admin_dashboard', {period:'week', q:q}) }}">Semaine</a>

    <a class="filter-btn {{ period == 'month' ? 'active' : '' }}"
       href="{{ path('admin_dashboard', {period:'month', q:q}) }}">Mois</a>
</div>

                    </div>
                    <canvas id="salesChart" height="300"></canvas>

                </div>

                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Top Produits</h2>
                    </div>
                    <div class="product-list">
    {% for p in topProduits %}
        <div class="product-item">
            <div class="product-rank">{{ p.rank }}</div>

            {% if p.image %}
                <img src="{{ p.image }}" alt="{{ p.nom }}" class="product-image">
            {% else %}
                <div class="product-image" style="display:flex;align-items:center;justify-content:center;background:#eee;">
                    🍔
                </div>
            {% endif %}

            <div class="product-details">
                <div class="product-name">{{ p.nom }}</div>
                <div class="product-sales">{{ p.total }} ventes</div>
            </div>
            <span class="product-badge">{{ p.badge }}</span>
        </div>
    {% else %}
        <div style="color:#8B4513;">Aucune donnée sur la période sélectionnée.</div>
    {% endfor %}
</div>


                </div>
            </div>

            <!-- Recent Orders -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Commandes récentes</h2>
                    <a href="#" class="filter-btn">
                        Voir tout
                    </a>

                </div>
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th>Client</th>
                            <th>Articles</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Heure</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for commande in recent.items %}
                    <tr>
                        <td class="order-id">#BB-{{ commande.id }}</td>
                        <td>{{ commande.client.prenom }} {{ commande.client.nom }}</td>
                        <td>{{ commande.items|length }} article(s)</td>
                        <td>{{ commande.total|number_format(0, ',', ' ') }} F</td>
                        <td>
                            <span class="status-badge">
                                {{ commande.etatCommande }}
                            </span>
                        </td>
                        <td>{{ commande.dateCommande|date('H:i') }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6">Aucune commande récente</td>
                    </tr>
                    {% endfor %}
                    </tbody>


                </table>
                {% if recent.pages > 1 %}
                <div style="margin-top:16px; display:flex; gap:8px;">
                    {% for p in 1..recent.pages %}
                        <a class="filter-btn {{ p == recent.page ? 'active' : '' }}"
                        href="{{ path('admin_dashboard', {page:p, period:period}) }}">
                            {{ p }}
                        </a>
                    {% endfor %}
                </div>
                {% endif %}


            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('active');
        }

        // Fermer la sidebar quand on clique en dehors sur mobile
        document.addEventListener('click', function(event) {
            const sidebar = document.querySelector('.sidebar');
            const menuBtn = document.querySelector('.btn-menu-mobile');
            
            if (window.innerWidth <= 1024) {
                if (!sidebar.contains(event.target) && event.target !== menuBtn && !menuBtn.contains(event.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
const ctx = document.getElementById('salesChart');

new Chart(ctx, {
    type: 'line',
    data: {
        labels: {{ salesLabels|json_encode|raw }},
        datasets: [{
            label: 'Ventes',
            data: {{ salesData|json_encode|raw }},
            borderColor: '#C8102E',
            backgroundColor: 'rgba(200,16,46,0.15)',
            tension: 0.4,
            fill: true
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false }
        }
    }
});
</script>

</body>
</html>