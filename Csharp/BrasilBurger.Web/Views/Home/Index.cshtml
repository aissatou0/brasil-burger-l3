@model BrasilBurger.Web.Models.ViewModels.HomeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Accueil";
}

<!-- Hero Section -->
<section class="hero">
    <h1 class="hero-title">Les Meilleurs Burgers du Brésil 🇧🇷</h1>
    <p class="hero-subtitle">Savourez l'authenticité brésilienne dans chaque bouchée</p>
</section>

<!-- Filtres -->
<section class="filters">
    <button class="filter-btn active" data-type="all">Tout</button>
    <button class="filter-btn" data-type="menus">Menus</button>
    <button class="filter-btn" data-type="burgers">Burgers</button>
    <button class="filter-btn" data-type="complements">Compléments</button>
</section>

<!-- PRODUITS -->
<section class="products" id="productsContainer"></section>

@section Scripts {
    <script src="~/js/home.js"></script>
}
