<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Brasil Burger</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Global CSS -->
    <link rel="stylesheet" href="~/css/home.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- HEADER -->
    <header class="header">
        <div class="header-content">
            <a asp-controller="Home" asp-action="Index" class="logo">
                <div class="logo-icon">🍔</div>
                <span class="logo-text">Brasil Burger</span>
            </a>

            <nav class="nav-actions">
                <span class="btn-login">
                    <i class="fas fa-user"></i>
                    @Context.Session.GetString("ClientNom")
                </span>

                <a asp-controller="Cart" asp-action="Index" class="btn-cart">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-badge">@ViewBag.CartCount</span>
                </a>

                <a asp-controller="Auth" asp-action="Logout" class="btn-login">
                    Déconnexion
                </a>
            </nav>
        </div>
    </header>

    <!-- MAIN -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h3>Brasil Burger</h3>
                <p>L'authenticité brésilienne dans chaque burger.</p>
            </div>
        </div>
    </footer>

    <!-- JS -->
    <script src="~/js/home.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
