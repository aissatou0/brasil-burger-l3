@model BrasilBurger.Web.Models.ViewModels.CheckoutViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Validation commande";
}

<h2 style="margin:2rem">Récapitulatif</h2>

<section class="products">
@foreach (var item in Model.Items)
{
    <div class="product-card">
        <img src="@item.Image" class="product-image" />
        <div class="product-info">
            <h3>@item.Nom</h3>
            <p>@item.Quantite x @item.Prix FCFA</p>
        </div>
    </div>
}
</section>

<h3 style="margin:2rem">Total : @Model.Total FCFA</h3>

<form asp-action="Confirm" method="post" style="margin:2rem">

    <!-- MODE DE RECUPERATION -->
    <h3>Mode de récupération</h3>
    <div style="display:flex; gap:1rem; margin-bottom:1.5rem">
        <label>
            <input type="radio" name="TypeCommande" value="SUR_PLACE" checked />
            Sur place
        </label>

        <label>
            <input type="radio" name="TypeCommande" value="A_EMPORTER" />
            À emporter
        </label>

        <label>
            <input type="radio" name="TypeCommande" value="LIVRAISON" />
            Livraison
        </label>
    </div>

    <!-- MODE DE PAIEMENT -->
    <h3>Mode de paiement</h3>
    <div style="display:flex; gap:1rem; margin-bottom:2rem">
        <label>
            <input type="radio" name="ModePaiement" value="WAVE" checked />
            Wave
        </label>

        <label>
            <input type="radio" name="ModePaiement" value="OM" />
            Orange Money
        </label>
    </div>

    <!-- TOTAL -->
    <h3>Total : @Model.Total FCFA</h3>

    <button class="btn-add" style="margin-top:1rem">
        Confirmer la commande
    </button>
</form>

